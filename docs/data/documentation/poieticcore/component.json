        },
        {
          "inlineContent" : [
            {
              "text" : "Components hold data that are used during runtime. They are typically",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "derived from object attributes.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Runtime components are not persisted.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This is just an annotation protocol, has no requirements.",
