          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Raw snapshot can be freely mutated and does not have to conform to any constraints, neither",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "has to have referential integrity with other snapshots within any other raw structure, unless",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "needed to be loaded.",
              "type" : "text"
