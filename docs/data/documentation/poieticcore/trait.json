    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Typically trait defines one or more attributes that together form a logical characteristics",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "of an object, such as formula, position, or a definition of a numeric indicator. Traits",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "can be also without attributes and just define roles of objects, such as simulation object.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Attribute-Namespaces",
          "level" : 2,
          "text" : "Attribute Namespaces",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "When multiple traits are associated with an ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ObjectType",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ", all attributes from all traits",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "share the same namespace. This means:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "No two traits on the same object type can define attributes with the same name",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Attributes can be queried by name on the object type, regardless of which trait defines them",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let Formula = Trait(",
            "    name: \"Formula\",",
            "    attributes: [",
            "        Attribute(\"formula\", type: .string, default: \"0\",",
            "                  abstract: \"Arithmetic expression or constant value\")",
            "    ],",
            "    abstract: \"Provides formula evaluation capability\"",
            ")",
            "",
            "\/\/ Use the trait in multiple object types",
            "let Stock = ObjectType(",
            "    name: \"Stock\",",
            "    topologyType: .node,",
            "    traits: [BasicDomain.Traits.Name, SimulationDomain.Traits.Formula]",
            ")",
            "",
            "let Auxiliary = ObjectType(",
            "    name: \"Auxiliary\",",
            "    topologyType: .node,",
            "    traits: [BasicDomain.Traits.Name, SimulationDomain.Traits.Formula]",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "All user-entered attributes should be included in the trait’s attribute list",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "to support data interchange and foreign interfaces.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Note",
          "style" : "note",
          "type" : "aside"
        },
