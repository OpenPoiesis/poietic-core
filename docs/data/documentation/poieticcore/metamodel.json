      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The Metamodel serves as the contract between the Modelling Domain (",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Design",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ") and the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Simulation Domain (",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/World",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : "). It defines:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Validation-Levels",
          "level" : 2,
          "text" : "Validation Levels",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The design has two levels of design validity:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Constraint Validity",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : ": Structural conformance defined by the Metamodel and checked by",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "All object types used in the design must be defined in the metamodel",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "All objects must conform to their type’s trait requirements",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "All edges must satisfy edge rules",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "All constraints must be satisfied",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    }
                  ],
                  "type" : "unorderedList"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Semantic Validity",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : ": Content domain-specific correctness, validated by modelling domain",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "systems.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                },
                {
                  "items" : [
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "Examples: formula syntax, variable references, circular dependencies",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "These may produce warnings\/errors but don’t prevent design editing and other usage by the",
                              "type" : "text"
                            },
                            {
                              "text" : " ",
                              "type" : "text"
                            },
                            {
                              "text" : "user.",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    },
                    {
                      "content" : [
                        {
                          "inlineContent" : [
                            {
                              "text" : "Metamodel is tangential to semantic validity.",
                              "type" : "text"
                            }
                          ],
                          "type" : "paragraph"
                        }
                      ]
                    }
                  ],
                  "type" : "unorderedList"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "An application is responsible for constraint validity of the design and should prevent further",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "manipulation of an invalid design.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Design-Plane-Acceptance",
          "level" : 2,
          "text" : "Design Plane Acceptance",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Before a ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/DesignPlane",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " is accepted into a ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Design",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ", it must pass constraint validation.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Planes that violate the metamodel are considered structurally invalid and should not be",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "persisted without repair. See ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Design\/accept(_:appendHistory:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Metamodel-Composition",
          "level" : 2,
          "text" : "Metamodel Composition",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Metamodels can be composed from multiple domain-specific metamodels using the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Metamodel\/init(name:version:merging:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " initialiser. When merging, later definitions override",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "earlier ones for traits, types, and constraints with the same name.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let metamodel = Metamodel(",
            "    name: \"MyDomain\",",
            "    version: SemanticVersion(1, 0, 0),",
            "    traits: [",
            "        Trait.Name,",
            "        Trait.Formula,",
            "        Trait.Position",
            "    ],",
            "    types: [",
            "        ObjectType.Stock,",
            "        ObjectType.Flow,",
            "        ObjectType.Parameter",
            "    ],",
            "    edgeRules: [",
            "        EdgeRule(type: ObjectType.Parameter, incoming: .many, outgoing: .many),",
            "        EdgeRule(type: ObjectType.Flow,",
            "                 origin: .isType(ObjectType.Stock),",
            "                 target: .isType(ObjectType.FlowRate),",
            "                 outgoing: .one,",
            "                 incoming: .one)",
            "    ],",
            "    constraints: [",
            "        Constraint(",
            "            name: \"unique_names\",",
            "            match: .hasTrait(\"Name\"),",
            "            requirement: UniqueProperty(\"name\")",
            "        )",
            "    ]",
            ")"
          ],
