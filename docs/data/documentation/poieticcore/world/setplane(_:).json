          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "When a new plane is set, the following happens:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Despawn removed design object – entities representing objects that are not present in",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "the new plane.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "See ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/World\/despawn(_:)-36uve",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Spawn new entities for new design objects. New design objects are objects with ObjectID",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "that are not present in the world.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Set ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ObjectTouched",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " tag on changed design object entities – entities that were",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "representing objects (by ",
                      "type" : "text"
                    },
                    {
                      "code" : "ObjectID",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ") in previous and in the new plane, but their",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "version snapshot (",
                      "type" : "text"
                    },
                    {
                      "code" : "ObjectSnapshotID",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ") has changed.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Clear ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ObjectTouched",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " tag on design object entities that remained the same.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "Incoming relationships such as ",
                  "type" : "text"
                },
                {
                  "code" : "RepresentationOf",
                  "type" : "codeVoice"
                },
                {
                  "text" : " survive plane changes",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "for unchanged and mutated objects.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
