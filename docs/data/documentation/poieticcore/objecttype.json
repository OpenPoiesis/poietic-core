              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " property determines the object’s role as a graph component:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
