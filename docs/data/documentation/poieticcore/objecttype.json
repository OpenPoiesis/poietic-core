              "content" : [
                {
                  "inlineContent" : [
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/TopologyType\/edge",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : ": Objects that connect two nodes (requires an ",
                      "type" : "text"
                    },
                    {
