          ],
          "type" : "unorderedList"
        },
        {
          "anchor" : "Traits-and-Attributes",
          "level" : 2,
          "text" : "Traits and Attributes",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Traits define groups of attributes that objects possess. All attributes from all traits",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "associated with an object type share the same namespace - no two traits in an object type",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "can define attributes with the same name. See ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Trait",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " for more information.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "let Stock = ObjectType(",
            "    name: \"Stock\",",
            "    topologyType: .node,",
            "    traits: [",
            "        Trait.Name,",
            "        Trait.Formula,",
            "        Trait.Stock,",
            "    ],",
            "    abstract: \"A reservoir that accumulates quantities over time\",",
            "    secondaryLabelAttribute: \"formula\"",
            ")",
            "",
            "let Flow = ObjectType(",
            "    name: \"Flow\",",
            "    topologyType: .edge,",
            "    abstract: \"Connection between a stock and a flow rate\"",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "For edge object types (",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ObjectType\/topologyType",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
                  "text" : " is ",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/TopologyType\/edge",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
                  "text" : "),",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "you must define a corresponding ",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
