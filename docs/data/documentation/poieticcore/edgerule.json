      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Edge rules are part of the design’s ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "Constraint Validity",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            },
            {
              "text" : " defined by design’s ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/Metamodel",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Each edge in a design must match at least one edge rule, and the matched rule’s cardinality",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "constraints must be satisfied.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "There are two validation use-cases using ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Pre-validation",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker\/canConnect(type:from:to:in:)",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : "): Checks if a new",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "edge ",
                      "type" : "text"
                    },
                    {
                      "inlineContent" : [
                        {
                          "text" : "could",
                          "type" : "text"
                        }
                      ],
                      "type" : "emphasis"
                    },
                    {
                      "text" : " be created. Used in interactive UIs before creating the edge.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "inlineContent" : [
                        {
                          "text" : "Validation",
                          "type" : "text"
                        }
                      ],
                      "type" : "strong"
                    },
                    {
                      "text" : " (",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker\/validate(edge:in:)",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : "): Checks existing edges in a plane.",
                      "type" : "text"
                    },
                    {
                      "text" : " ",
                      "type" : "text"
                    },
                    {
                      "text" : "Used when accepting planes into the design.",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "To collect all issues with edges (and other constraints) within a design you can use",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ConstraintChecker\/diagnose(_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Rule-Matching-Process",
          "level" : 2,
          "text" : "Rule Matching Process",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "An edge matches a rule when ALL of the following conditions are met:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "The edge’s ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/ObjectType",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " matches the rule’s ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule\/type",
                      "isActive" : true,
                      "type" : "reference"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "If ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule\/originPredicate",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " is specified, the edge’s origin node must satisfy it",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "If ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule\/targetPredicate",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " is specified, the edge’s target node must satisfy it",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "The number of matching edges at the origin satisfies ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule\/outgoing",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " cardinality",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "The number of matching edges at the target satisfies ",
                      "type" : "text"
                    },
                    {
                      "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRule\/incoming",
                      "isActive" : true,
                      "type" : "reference"
                    },
                    {
                      "text" : " cardinality",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "orderedList"
        },
        {
          "anchor" : "Examples",
          "level" : 2,
          "text" : "Examples",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "inlineContent" : [
                {
                  "text" : "Example 1: Unrestricted connections",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "\/\/ Allow any node to connect to any node via Parameter edge",
            "let parameterRule = EdgeRule(",
            "    type: ObjectType.Parameter,",
            "    \/\/ No predicates = any node matches",
            "    outgoing: .many,  \/\/ Multiple parameters can originate from same node",
            "    incoming: .many   \/\/ Multiple parameters can target same node",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "inlineContent" : [
                {
                  "text" : "Example 2: Restricted connections with cardinality",
                  "type" : "text"
                }
              ],
              "type" : "strong"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "\/\/ Flow edge must connect Stock (origin) to FlowRate (target)",
            "\/\/ Each flow has exactly one source and one drain",
            "let flowRule = EdgeRule(",
            "    type: ObjectType.Flow,",
            "    origin: .isType(ObjectType.Stock),",
            "    outgoing: .many,  \/\/ Stock can have many outgoing flows",
            "    target: .isType(ObjectType.FlowRate),",
            "    incoming: .one    \/\/ FlowRate has exactly one incoming flow",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "anchor" : "Rule-Ordering-and-Precedence",
          "level" : 2,
          "text" : "Rule Ordering and Precedence",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "When multiple rules exist for the same edge type, the first matching rule is used.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "More specific rules (with predicates) should be listed before general rules.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "There must be at least one rule for each edge type defined in the metamodel.",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "Edges without any matching rule will fail validation with ",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/EdgeRuleViolation\/edgeNotAllowed",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
                  "text" : ".",
