        {
          "inlineContent" : [
            {
              "text" : "An ordered set of object identifiers with convenience methods to support typical user",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "application actions. For example toggling a selected object using ",
