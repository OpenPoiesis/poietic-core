            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "create and populated first plane:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "let design = Design(metamodel: Metamodel.Basic)",
            "let trans = design.createPlane()",
            "let object = trans.create(ObjectType.DesignInfo)",
            "object[\"title\"] = \"My Design\"",
            "",
            "try design.accept(trans)"
          ],
