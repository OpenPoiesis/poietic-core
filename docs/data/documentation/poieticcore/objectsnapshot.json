    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Immutable, point-in-time capture of an object’s state.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This is the primary design entity. Stable objects can be shared between",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "multiple planes.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Once created, stable object’s design properties (attributes and topology)",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "can not be changed. Only changes that can be made to an object is to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "add or remove runtime components.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Creation",
          "level" : 2,
          "text" : "Creation",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "To create an object and to include it in the design, the object’s identity",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "needs to be assured. It can be either provided by the design, taken",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "from an external source or created in a custom way.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "To create a new object, use the ``TransientPlane\/create(_:objectID:snapshotID:topology:parent:children:attributes:)",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "method:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "let design: Design \/\/ Let's assume we have this",
            "let trans = design.createPlane()",
            "let object = trans.create(MyObjectType)",
            "\/\/ ... Modify the object here ...",
            "\/\/ ... Add more objects...",
            "try design.accept(trans)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "",
                  "type" : "text"
                },
                {
                  "identifier" : "doc:\/\/PoieticCore\/documentation\/PoieticCore\/DesignPlane",
                  "isActive" : true,
                  "type" : "reference"
                },
                {
